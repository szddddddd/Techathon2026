    "test:forest": "node scripts/test-vertical-surface.mjs && node scripts/test-forest-layout.mjs",
    "test:forest:browser": "node scripts/test-forest-browser.mjs",
    "test:performance:browser": "node scripts/test-performance-browser.mjs",
    "benchmark:performance": "node scripts/benchmark-performance.mjs",
    "test:avatar": "node scripts/test-avatar-pipeline.mjs && node scripts/test-friend-models.mjs && node scripts/test-avatar-browser.mjs",
    "test:regression": "node scripts/run-regression.mjs",
    "audit:social": "node scripts/audit-social-characters.mjs",
    "record:discovery": "node scripts/record-discovery.mjs",
    "audit:discovery": "node scripts/audit-discovery.mjs",
    "test:presence": "node scripts/test-presence-policy.mjs && node scripts/test-social-presence.mjs",
    "test:actions": "node scripts/test-character-actions.mjs && node scripts/test-action-interactions.mjs",
    "test:interactions": "node scripts/test-ui-interactions.mjs && node scripts/test-ui-edge-cases.mjs",
    "test:browser": "node scripts/test-discovery-browser.mjs",
    "test:discovery-icons": "node scripts/test-discovery-scene-icons.mjs",
    "test:boards": "node scripts/test-discovery-boards.mjs",
    "test:anchors": "node scripts/test-social-anchors.mjs",
    "test:camera": "node scripts/test-camera-pan.mjs",
    "test:desktop-bridge": "node scripts/test-desktop-bridge.mjs",
    "test:pet": "node scripts/test-web-pet.mjs",
    "test:drag": "node scripts/test-character-drag.mjs",
    "test:placement": "node scripts/test-placement-clearance.mjs",
    "desktop:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-desktop-launcher.ps1",
    "launch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch.ps1",
    "test:launch": "node scripts/test-launch.mjs",
    "test:river": "node scripts/test-river.mjs && node scripts/test-river-browser.mjs",
    "test:valley": "node scripts/test-valley.mjs && node scripts/test-valley-browser.mjs",
    "test:mountain": "node scripts/test-mountain-range.mjs && node scripts/test-mountain-browser.mjs",
    "test:groups": "node scripts/test-group-chat.mjs && node scripts/test-group-scene.mjs && node scripts/test-group-browser.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "electron": "^36.3.2",
    "esbuild": "^0.25.10",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.64.1"
  },
  "engines": {
    "node": ">=22"
  }
}
