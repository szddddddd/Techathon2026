{
  "name": "world",
  "version": "1.3.0",
  "description": "林间来信：三维森林社交与 Windows 桌宠",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
