{
  "name": "world",
  "version": "1.0.0",
  "description": "Reference-inspired editable Three.js forest diorama",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --minify --outfile=dist/world.js && esbuild src/asset-review.js --bundle --format=iife --minify --outfile=dist/review.js && esbuild src/pet.js --bundle --format=iife --minify --outfile=dist/pet.js",
    "start": "python -m http.server 8080 --bind 127.0.0.1",
    "desktop": "electron .",
    "test": "node scripts/test-social-store.mjs && node scripts/test-social-feed.mjs && node scripts/test-discovery-store.mjs",
    "audit:social": "node scripts/audit-social-characters.mjs",
    "record:discovery": "node scripts/record-discovery.mjs",
    "audit:discovery": "node scripts/audit-discovery.mjs",
    "test:browser": "node scripts/test-discovery-browser.mjs",
    "test:boards": "node scripts/test-discovery-boards.mjs",
    "test:anchors": "node scripts/test-social-anchors.mjs",
    "test:camera": "node scripts/test-camera-pan.mjs",
    "test:desktop-bridge": "node scripts/test-desktop-bridge.mjs",
    "test:pet": "node scripts/test-web-pet.mjs",
    "test:drag": "node scripts/test-character-drag.mjs",
    "test:placement": "node scripts/test-placement-clearance.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "electron": "^36.3.2",
    "fake-indexeddb": "^6.2.5"
  }
}
